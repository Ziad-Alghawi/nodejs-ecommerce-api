# Copy this file to .env and replace the dummy values.

# Server
PORT=8000
NODE_ENV=development
# Base URL used to build image links
BASE_URI=http://localhost:8000
# Number of reverse proxies in front of the app (0 locally, 1 on Render)
TRUST_PROXY=0

# Database
DB_URI=mongodb://127.0.0.1:27017/ecommerce-demo

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRES_TIME=90d

# Email (only needed for the forgot-password flow)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=demo@example.com
EMAIL_PASS=dummy-email-password

# Stripe (test mode keys only; the app will not start without STRIPE_SECRET)
STRIPE_SECRET=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
